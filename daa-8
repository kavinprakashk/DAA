from itertools import permutations

INF = float('inf')


# Function to solve TSP using Brute Force
def tsp_brute_force(cost, n):
    best_cost = INF
    best_path = None

    cities = list(range(1, n))

    for perm in permutations(cities):
        path = [0] + list(perm) + [0]

        total_cost = sum(
            cost[path[i]][path[i + 1]]
            for i in range(n)
        )

        if total_cost < best_cost:
            best_cost = total_cost
            best_path = path

    return best_path, best_cost



cost = [
    [INF, 12, 10, 19, 8, 15],
    [12, INF, 3, 7, 6, 9],
    [10, 3, INF, 6, 20, 11],
    [19, 7, 6, INF, 9, 13],
    [8, 6, 20, 9, INF, 5],
    [15, 9, 11, 13, 5, INF]
]

n = 6

cities = ['A', 'B', 'C', 'D', 'E', 'F']




best_path, best_cost = tsp_brute_force(cost, n)


print("6-City TSP - Cost Matrix:\n")

print(f'{"":>4}', ' '.join(f'{city:>5}' for city in cities))

for i, row in enumerate(cost):
    values = [
        'INF' if value == INF else str(value)
        for value in row
    ]

    print(
        f'{cities[i]:>4}',
        ' '.join(f'{value:>5}' for value in values)
    )



print(
    f'\nOptimal Tour: '
    f'{" -> ".join(cities[i] for i in best_path)}'
)

print(f'Minimum Cost: {best_cost}')




print('\nPath Verification:')

for i in range(n):
    u = best_path[i]
    v = best_path[i + 1]

    print(
        f'  {cities[u]} -> {cities[v]}: '
        f'cost = {cost[u][v]}'
    )
